# Environment Configuration for AI-Powered Product Intelligence Platform
APP_NAME="AI-Powered Product Intelligence Backend"
APP_ENV=development
DEBUG=true

# Database Connection (PostgreSQL with SQLite dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_intelligence
# To use SQLite for lightweight testing if Postgres is not running:
# DATABASE_URL=sqlite:///./product_intelligence.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Allowed Origins
FRONTEND_URL=http://localhost:3000

# Server Binding
HOST=0.0.0.0
PORT=8000
